# Required when the SQLite database is empty on first startup.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-strong-password

# Required for Caddy-managed automatic HTTPS. Point DNS to this server.
PUBLIC_DOMAIN=logs.cloudeskaerp.test

# Directories users may browse through local-folder connections.
LOG_ALLOWED_ROOTS=/var/log,/app/data

# Required for DBX. This password is used to encrypt the database and must be set before first startup.
DBX_PASSWORD=replace-with-a-strong-password