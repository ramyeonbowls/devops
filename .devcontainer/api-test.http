### LogPulse API — REST Client Tests
### Install extension: humao.rest-client

@base = http://localhost:3000

# ── Auth ──────────────────────────────────────────────────

### Login (benar)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

### Login (salah)
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "salah"
}

### Get current user
GET {{base}}/api/auth/me

# ── Health ────────────────────────────────────────────────

### Health check
GET {{base}}/api/health

# ── Connections ───────────────────────────────────────────

### List connections
GET {{base}}/api/connections

### Create connection (SSH)
POST {{base}}/api/connections
Content-Type: application/json

{
  "name": "My Server",
  "type": "ssh",
  "host": "192.168.1.100",
  "port": 22,
  "username": "root",
  "authMethod": "password",
  "password": "secret",
  "remotePath": "/var/log"
}

# ── Users ─────────────────────────────────────────────────

### List users
GET {{base}}/api/users

### Create user
POST {{base}}/api/users
Content-Type: application/json

{
  "username": "operator",
  "password": "Pass1234",
  "name": "Operator User",
  "role": "Site Reliability Engineer (L5)"
}

# ── Metrics ───────────────────────────────────────────────

### Get metrics
GET {{base}}/api/metrics

### Get settings
GET {{base}}/api/settings
