FROM node:22-alpine AS builder

WORKDIR /app
COPY logs/package.json logs/package-lock.json ./
RUN npm ci
COPY logs/index.html ./index.html
COPY logs/src ./src
COPY logs/vite.config.ts ./vite.config.ts
COPY logs/tsconfig.json ./tsconfig.json
COPY logs/metadata.json ./metadata.json
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist/ /usr/share/nginx/html/
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
